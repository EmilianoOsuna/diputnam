---
import { Image, Picture } from 'astro:assets';
import putnamMark from '../assets/putnam-light.png';
import heroImage from '../assets/contacto-hero.jpg';
import ContactFooter from '../components/ContactFooter.astro';
import Lines from '../components/Lines.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { contactoChannels, contactoCta, contactoForm, contactoHero, contactoLocation, contactoReasons } from '../data/contacto';
import { contact } from '../data/home';
import { t, type Lang } from '../i18n';
import '../styles/global.css';
import '../styles/contacto.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const form = ui.contacto.form;
const mapEmbed = `https://www.google.com/maps?q=${contact.coordinates.latitude},${contact.coordinates.longitude}&output=embed`;
const pad = (index: number) => String(index + 1).padStart(2, '0');
---
<html lang={lang}>
  <head>
    <SiteHead lang={lang} page="contacto" />
  </head>
  <body class="contacto-page">
    <a class="skip-link" href="#contenido">{ui.skipLink}</a>
    <SiteHeader lang={lang} page="contacto" contacto />

    <main id="contenido" data-contacto>
      <section class="ct-hero" id="inicio" aria-labelledby="ct-hero-title" data-header-theme="light">
        <div class="hero-copy">
          <p class="section-kicker fade-up"><span>{contactoHero.kicker} · {contact.city}</span></p>
          <h1 id="ct-hero-title"><Lines text={contactoHero.title} /></h1>
        </div>
        <div class="hero-details fade-up">
          <div><p class="hero-lead">{contactoHero.lead}</p><a class="hero-index" href="#canales">{ui.contacto.seeChannels} <span aria-hidden="true">↓</span></a></div>
          <div class="hero-meta"><span>{contact.hoursShort}</span><span>{ui.contacto.responseIn(contact.responseTime)}</span></div>
        </div>
        <figure class="hero-frame" data-parallax>
          <Picture src={heroImage} formats={['avif', 'webp']} widths={[640, 840, 1280]} sizes="100vw" quality="mid" alt={ui.contacto.heroAlt} loading="eager" decoding="async" fetchpriority="high" />
        </figure>
      </section>

      <section class="ct-channels" id="canales" aria-labelledby="ct-channels-title" data-header-theme="dark">
        <header class="ct-channels-head grid-12">
          <div><p class="section-kicker">{contactoChannels.kicker}</p><h2 id="ct-channels-title"><Lines text={contactoChannels.title} /></h2></div>
          <p data-reveal-group>{contactoChannels.text}</p>
        </header>
        <div class="index-list" data-reveal-group>
          <a class="index-row" href={contact.whatsapp} target="_blank" rel="noreferrer"><span>01</span><div><small>{ui.whatsapp}</small><strong>{contact.phone}</strong></div><i aria-hidden="true">↗</i></a>
          <a class="index-row" href={`mailto:${contact.email}`}><span>02</span><div><small>{ui.contacto.email}</small><strong>{contact.email}</strong></div><i aria-hidden="true">↗</i></a>
          <div class="index-row"><span>03</span><div><small>{ui.contacto.office}</small><strong>{contact.address}</strong></div><i aria-hidden="true"></i></div>
          <div class="index-row"><span>04</span><div><small>{ui.contacto.hours}</small><strong>{contact.hours}</strong></div><i aria-hidden="true"></i></div>
        </div>
        <div class="kpis" data-reveal-group>
          {contactoChannels.kpis.map((kpi) => <div class="kpi"><b>{kpi.value ?? contact.responseTime}</b><span>{kpi.label}</span></div>)}
        </div>
      </section>

      <section class="ct-reasons" id="motivos" aria-labelledby="ct-reasons-title" data-reasons data-header-theme="light">
        <div class="pin-stage" data-pin-stage>
          <div><p class="section-kicker">{contactoReasons.kicker}</p><h2 id="ct-reasons-title">{contactoReasons.title}</h2></div>
          <div><div class="pin-counter"><b data-pin-current data-track-current>01</b><span aria-hidden="true">/</span><span>{pad(contactoReasons.items.length - 1)}</span></div><div class="pin-rail" aria-hidden="true"><span data-pin-rail data-track-rail></span></div></div>
        </div>
        <div class="reasons" data-reasons-track>
          {contactoReasons.items.map((reason, index) => (
            <article class:list={["reason", { "is-active": index === 0 }]} data-reason={index}><span>{pad(index)} — {reason.tag}</span><h3>{reason.title}</h3><p>{reason.text}</p>{reason.href === 'whatsapp' ? <a href={contact.whatsapp} target="_blank" rel="noreferrer">{reason.cta} <span aria-hidden="true">→</span></a> : <a href={reason.href}>{reason.cta} <span aria-hidden="true">→</span></a>}</article>
          ))}
        </div>
      </section>

      <section class="ct-location grid-12" id="ubicacion" aria-labelledby="ct-location-title" data-header-theme="dark">
        <figure class="ct-map"><iframe src={mapEmbed} title={ui.contacto.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></figure>
        <div class="ct-location-copy">
          <p class="section-kicker">{contactoLocation.kicker}</p>
          <h2 id="ct-location-title"><Lines text={contactoLocation.title} /></h2>
          <p data-reveal-group>{contactoLocation.text}</p>
          <dl data-reveal-group><div><dt>{ui.contacto.address}</dt><dd>{contact.address} · {contact.city}</dd></div><div><dt>{ui.contacto.schedule}</dt><dd>{contact.hours}</dd></div></dl>
          <div class="cta-actions"><a href={contact.mapsUrl} target="_blank" rel="noreferrer">{ui.contacto.openMaps} <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section class="ct-form" id="formulario" aria-labelledby="ct-form-title" data-header-theme="dark">
        <header class="ct-form-head grid-12">
          <div><p class="section-kicker">{contactoForm.kicker}</p><h2 id="ct-form-title">{contactoForm.title}</h2></div>
          <p data-reveal-group>{contactoForm.text(contact.responseTime)}</p>
        </header>
        <form action="#" aria-label={form.aria}>
          <div data-reveal-group>
            <div class="f-row"><span>01</span><label for="ct-nombre">{form.name}</label><input id="ct-nombre" name="nombre" type="text" autocomplete="name" placeholder={form.namePlaceholder} /></div>
            <div class="f-row"><span>02</span><label for="ct-empresa">{form.company}</label><input id="ct-empresa" name="empresa" type="text" autocomplete="organization" placeholder={form.companyPlaceholder} /></div>
            <div class="f-row"><span>03</span><label for="ct-email">{form.email}</label><input id="ct-email" name="email" type="email" autocomplete="email" placeholder={form.emailPlaceholder} /></div>
            <div class="f-row"><span>04</span><label for="ct-telefono">{form.phone}</label><input id="ct-telefono" name="telefono" type="tel" autocomplete="tel" placeholder={form.phonePlaceholder} /></div>
            <div class="f-row"><span>05</span><label for="ct-motivo">{form.reason}</label><select id="ct-motivo" name="motivo" data-custom-select>{form.reasons.map((reason) => <option>{reason}</option>)}</select></div>
            <div class="f-row f-row--text"><span>06</span><label for="ct-mensaje">{form.message}</label><textarea id="ct-mensaje" name="mensaje" placeholder={form.messagePlaceholder}></textarea></div>
          </div>
          <div class="f-submit"><p>{form.consent}</p><button type="button">{form.submit} <span aria-hidden="true">→</span></button></div>
        </form>
      </section>

      <section class="ct-cta" aria-labelledby="ct-cta-title" data-header-theme="light">
        <p class="section-kicker">{contactoCta.kicker}</p>
        <h2 id="ct-cta-title"><Lines text={contactoCta.title} /></h2>
        <p data-reveal-group>{contactoCta.text}</p>
        <div class="cta-actions" data-reveal-group><a href={contact.whatsapp} target="_blank" rel="noreferrer">{ui.contacto.openWhatsapp} <span aria-hidden="true">↗</span></a></div>
        <Image class="cta-mark" src={putnamMark} widths={[400, 800]} sizes="(max-width: 767px) 72vw, min(42vw, 42rem)" format="webp" alt="" aria-hidden="true" />
      </section>
    </main>
    <ContactFooter lang={lang} />
    <script src="../scripts/contacto-motion.ts"></script>
  </body>
</html>
