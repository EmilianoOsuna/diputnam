---
// Landing page of the Ereditá line: hero with the mark, the line's concept and one card
// per published project, each linking to its own page (see proyecto.astro).
import { Picture } from 'astro:assets';
import erediteMark from '../assets/eredita-logo.png';
import CmsImg from '../components/CmsImg.astro';
import ContactFooter from '../components/ContactFooter.astro';
import Lines from '../components/Lines.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { projectPath, t, type Lang } from '../i18n';
import { getEredita, getProyectos, getSettings } from '../lib/content';
import { CARD_WIDTHS, HERO_WIDTHS, SAT, imageSrc } from '../lib/images';
import '../styles/global.css';
import '../styles/eredita.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const [page, projects, contact] = await Promise.all([getEredita(lang), getProyectos(lang), getSettings(lang)]);
const { hero, intro, cta } = page;
---
<html lang={lang}>
  <head>
    <SiteHead lang={lang} page="eredita" settings={contact} />
  </head>
  <body class="eredita-page">
    <a class="skip-link" href="#contenido">{ui.skipLink}</a>
    <SiteHeader lang={lang} page="eredita" contact={contact} />

    <main id="contenido" data-eredita>
      <section class="ed-hero" aria-labelledby="ed-hero-title" data-header-theme="light">
        <div class="ed-hero-media" data-parallax>
          {hero.video ? (
            <video poster={imageSrc(hero.poster)} autoplay muted loop playsinline aria-hidden="true">
              <source src={hero.video} type="video/mp4" />
            </video>
          ) : (
            <CmsImg image={hero.poster} base={1280} widths={HERO_WIDTHS} quality={78} sizes="100vw" width="2200" height="1400" fetchpriority="high" />
          )}
          <div class="ed-hero-shade"></div>
        </div>
        <Picture class="ed-hero-mark" src={erediteMark} widths={[320, 640, 960]} sizes="(max-width: 767px) 40vw, min(26vw, 24rem)" formats={['webp']} fallbackFormat="png" alt="Ereditá" loading="eager" />
        <div class="ed-hero-content" data-reveal-group>
          <p class="section-kicker">{hero.kicker}</p>
          <h1 id="ed-hero-title"><Lines text={hero.title} /></h1>
          <p class="ed-hero-sub">{hero.sub}</p>
        </div>
      </section>

      <section class="ed-intro" aria-labelledby="ed-intro-title" data-header-theme="dark">
        <figure class="ed-map" data-reveal-group>
          <iframe src={`https://www.google.com/maps?q=${contact.coordinates.lat},${contact.coordinates.lng}&output=embed`} title="Ubicación del proyecto" loading="lazy" />
        </figure>
        <div class="ed-intro-copy" data-reveal-group>
          <p class="section-kicker">{intro.kicker}</p>
          <h2 id="ed-intro-title"><Lines text={intro.title} /></h2>
          <p class="ed-lead">{intro.lead}</p>
          <dl class="ed-facts">
            {intro.facts.map((fact) => (
              <div class="ed-fact"><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
            ))}
          </dl>
        </div>
      </section>

      <section class="ed-projects" aria-labelledby="ed-projects-title" data-header-theme="light">
        <header class="section-heading" data-reveal-group>
          <p class="section-kicker">{page.projects.kicker}</p>
          <h2 id="ed-projects-title"><Lines text={page.projects.title} /></h2>
          {page.projects.text && <p class="ed-projects-lead">{page.projects.text}</p>}
        </header>
        <ul class="ed-project-list" data-reveal-group aria-label={ui.eredita.projects}>
          {projects.map((project, index) => (
            <li class="ed-project" data-project>
              <a class="ed-project-link" href={projectPath(lang, project.slug)}>
                <figure class="ed-project-media">
                  <CmsImg image={project.card.image} base={960} widths={CARD_WIDTHS} quality={75} sat={SAT.card} sizes="(min-width: 900px) 58vw, 100vw" loading="lazy" width="1600" height="1000" />
                </figure>
                <div class="ed-project-copy">
                  <div class="ed-project-head">
                    <span class="ed-h-index">0{index + 1}<i>/</i>0{projects.length}</span>
                    {project.status && <span class="ed-h-tag">{project.status}</span>}
                  </div>
                  <h3>{project.name}</h3>
                  <p>{project.card.text}</p>
                  <span class="ed-cta-link">{ui.eredita.viewProject} <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="ed-cta" aria-labelledby="ed-cta-title" data-reveal-group data-header-theme="light">
        <div class="ed-cta-copy">
          <p class="section-kicker">{cta.kicker}</p>
          <h2 id="ed-cta-title"><Lines text={cta.title} /></h2>
          <div class="cta-actions">
            <a href={`mailto:${contact.email}`}>{ui.writeUs} <span aria-hidden="true">↗</span></a>
            <a href={contact.whatsapp} target="_blank" rel="noreferrer">{ui.whatsapp} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <Picture pictureAttributes={{ class: 'cta-mark' }} src={erediteMark} widths={[320, 640, 960]} sizes="(max-width: 767px) min(50vw, 14rem), min(45vw, 38rem)" formats={['webp']} fallbackFormat="png" alt="" aria-hidden="true" />
      </section>
    </main>
    <ContactFooter lang={lang} contact={contact} />
    <script src="../scripts/eredita-motion.ts"></script>
  </body>
</html>
