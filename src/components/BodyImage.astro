---
// Portable Text `image` block inside a note body.
import { CARD_WIDTHS, remoteImage, remoteSrcset } from '../lib/images';
interface Props { node: { url: string; width?: number; height?: number; alt?: string }; }
const { node } = Astro.props;
---
<figure class="nw-article-figure">
  <img src={remoteImage(node.url, 960, 78)} srcset={remoteSrcset(node.url, CARD_WIDTHS, 78)} sizes="(min-width: 900px) 46rem, 100vw" alt={node.alt ?? ''} width={node.width} height={node.height} loading="lazy" decoding="async" />
</figure>
