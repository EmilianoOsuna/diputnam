---
// Decorative arrow for action links and buttons. An inline SVG instead of the `→`/`↗`
// characters: the latin subset of DM Sans has neither glyph, so browsers fall back to a
// system font and iOS draws `↗` (which has the Emoji property) with Apple Color Emoji.
// The wrapper keeps the element each site already styles (`span` or `i`) so the existing
// hover/transition selectors keep working; the icon inherits size (1em) and colour.
interface Props { dir?: 'right' | 'up-right'; as?: 'span' | 'i'; }
const { dir = 'right', as: Tag = 'span' } = Astro.props;
const path = dir === 'up-right' ? 'M4 12 12 4M5.5 4H12v6.5' : 'M2 8h12M9 3l5 5-5 5';
---
<Tag class="arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={path} /></svg></Tag>
