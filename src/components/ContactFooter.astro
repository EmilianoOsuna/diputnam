---
import { pages, t, type Lang, type PageKey } from '../i18n';
import type { Settings } from '../lib/content';
import SocialLinks from './SocialLinks.astro';
interface Props { lang: Lang; contact: Settings; fixed?: boolean; }
const { lang, contact, fixed = false } = Astro.props;
const ui = t(lang);
const links = (['eredita', 'putnam', 'noticias', 'unete', 'contacto'] as const satisfies readonly PageKey[]).map((key) => ({ label: ui.nav[key], href: pages[key][lang] }));
---
<footer class:list={["site-footer", { "site-footer--flow": !fixed }]} id={fixed ? undefined : 'contacto'}>
  {/* Home (fixed): contact left, icons right. Inner pages: brand + nav + social, then contact + credit. */}
  {!fixed && (
    <div class="footer-top">
      <span class="footer-brand">Putnam</span>
      <nav class="footer-nav" aria-label={ui.nav.aria}>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <SocialLinks lang={lang} contact={contact} />
    </div>
  )}
  <div class="footer-bottom">
    <div class="footer-contact"><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={`tel:${contact.phone.replaceAll(' ', '')}`}>{contact.phone}</a><span>{contact.city}</span></div>
    {fixed && (
      <SocialLinks lang={lang} contact={contact} />
    )}
    <a class="footer-credit" href="https://emilianoosuna.com" target="_blank" rel="noreferrer" aria-label={`${ui.footer.credit}: Emiliano Osuna`}>
      <img src="/assets/emiliano-osuna.png" alt="" width="20" height="20" loading="lazy" decoding="async" />
    </a>
  </div>
</footer>
