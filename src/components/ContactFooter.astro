---
import { contact } from '../data/home';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; fixed?: boolean; }
const { lang, fixed = false } = Astro.props;
const ui = t(lang);
---
<footer class:list={["site-footer", { "site-footer--flow": !fixed }]} id={fixed ? undefined : 'contacto'}>
  <div class="footer-contact"><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={`tel:${contact.phone.replaceAll(' ', '')}`}>{contact.phone}</a></div>
  <div class="footer-address"><span>{contact.city}</span><a href={contact.whatsapp} target="_blank" rel="noreferrer">{ui.whatsapp} ↗</a></div>
</footer>
