---
import View from '../../../views/proyecto.astro';
import { getProyecto, getProyectos } from '../../../lib/content';

export const getStaticPaths = async () => Promise.all((await getProyectos('en')).map(async ({ slug }) => ({ params: { slug }, props: { project: await getProyecto('en', slug) } })));
const { project } = Astro.props;
---
<View lang="en" project={project} />
